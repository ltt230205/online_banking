APP_NAME=Online Banking API
APP_ENV=development
API_PORT=8000
JWT_SECRET_KEY=change-this-jwt-secret-in-real-environments
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

POSTGRES_DB=online_banking
POSTGRES_USER=banking
POSTGRES_PASSWORD=local_dev_change_me
# Use localhost for Python on the host. Compose overrides this to db.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Local seed only. Change immediately outside a disposable development database.
SEED_ADMIN_PASSWORD=Admin@123
SEED_EMPLOYEE_PASSWORD=Employee@123
SEED_CUSTOMER_PASSWORD=Customer@123
