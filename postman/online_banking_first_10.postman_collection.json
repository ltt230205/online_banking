{
  "info": {
    "name": "Online Banking - API 01-10",
    "description": "Mười bước đầu trong docs/API_TEST_SCENARIO.md. Chỉ chạy trên local/demo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Root",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": []
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Có đường dẫn docs\", () => pm.expect(pm.response.json().docs).to.eql(\"/docs\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Database connected\", () => pm.expect(pm.response.json().database).to.eql(\"connected\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Register demo customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/auth/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"demo_{{suffix}}\",\n  \"password\": \"{{demo_password}}\",\n  \"email\": \"demo_{{suffix}}@example.com\",\n  \"phone\": \"09{{suffix}}\",\n  \"full_name\": \"Nguyen Van Demo\",\n  \"date_of_birth\": \"2000-01-01\",\n  \"identity_number\": \"DEMO{{suffix}}\",\n  \"address\": \"Ha Noi\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"KYC PENDING\", () => pm.expect(pm.response.json().kyc_status).to.eql(\"PENDING\"));",
              "pm.collectionVariables.set(\"new_customer_id\", pm.response.json().customer_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Login admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"{{admin_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Có access token\", () => pm.expect(pm.response.json().access_token).to.be.a(\"string\").and.not.empty);",
              "pm.collectionVariables.set(\"admin_token\", pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - OAuth2 token customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/auth/token",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "token"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "customer1",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{customer_password}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Có access token\", () => pm.expect(pm.response.json().access_token).to.be.a(\"string\").and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Admin customers pending",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/admin/customers?kyc_status=PENDING",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "customers?kyc_status=PENDING"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Danh sách khách hàng\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Verify KYC",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/admin/customers/{{new_customer_id}}/kyc",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "customers",
            "{{new_customer_id}}",
            "kyc"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"VERIFIED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"KYC VERIFIED\", () => pm.expect(pm.response.json().kyc_status).to.eql(\"VERIFIED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Create employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/admin/employees",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "employees"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"employee_{{suffix}}\",\n  \"password\": \"{{employee_password}}\",\n  \"email\": \"employee_{{suffix}}@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Tạo nhân viên\", () => pm.expect(pm.response.json().username).to.eql(`employee_${pm.collectionVariables.get(\"suffix\")}`));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Admin users",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/admin/users?page=1&page_size=100",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "users?page=1&page_size=100"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Có nhân viên vừa tạo\", () => pm.expect(pm.response.json().some(u => u.username === `employee_${pm.collectionVariables.get(\"suffix\")}`)).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Admin accounts",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/admin/accounts?page=1&page_size=100",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "accounts?page=1&page_size=100"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Có tài khoản mẫu\", () => pm.expect(pm.response.json().some(a => a.account_number === \"1000000001\")).to.be.true);"
            ]
          }
        }
      ]
    }
