{
  "info": {
    "name": "Online Banking - Full 30 API Test",
    "description": "Run in order against the LOCAL demo database only. Creates a customer, employee, payee, transfer and payment; soft-deletes only the payee created in this run. Set admin_password and customer_password collection variables before running. API 09 may fail on existing @bank.local seed email data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key":"base_url","value":"http://127.0.0.1:8000"},
    {"key":"admin_password","value":""},
    {"key":"customer_password","value":""},
    {"key":"demo_password","value":""},
    {"key":"employee_password","value":""},
    {"key":"suffix","value":""},
    {"key":"admin_token","value":""},
    {"key":"customer_token","value":""},
    {"key":"new_customer_id","value":""},
    {"key":"source_account_id","value":""},
    {"key":"payee_id","value":""},
    {"key":"invoice_id","value":""},
    {"key":"transaction_id","value":""},
    {"key":"transfer_otp","value":""},
    {"key":"payment_id","value":""},
    {"key":"payment_otp","value":""}
  ],
  "event": [
    {"listen":"prerequest","script":{"type":"text/javascript","exec":[
      "if (pm.info.requestName.startsWith('01 -')) {",
      "  pm.collectionVariables.set('suffix', Date.now().toString().slice(-10));",
      "  ['admin_token','customer_token','new_customer_id','source_account_id','payee_id','invoice_id','transaction_id','transfer_otp','payment_id','payment_otp'].forEach(k => pm.collectionVariables.unset(k));",
      "}"
    ]}},
    {"listen":"test","script":{"type":"text/javascript","exec":[
      "const n = Number(pm.info.requestName.slice(0, 2));",
      "const expected = {3:201,8:201,16:201,19:201,23:201,28:204}[n] || 200;",
      "pm.test('HTTP ' + expected, () => pm.response.to.have.status(expected));",
      "if (pm.response.code < 400 && n !== 28) {",
      "const data = pm.response.json();",
      "const set = (k, v) => { pm.expect(v, k).to.not.be.undefined; pm.collectionVariables.set(k, String(v)); };",
      "if (n === 2) pm.test('Database connected', () => pm.expect(data.database).to.eql('connected'));",
      "if (n === 3) { set('new_customer_id', data.customer_id); pm.test('KYC pending', () => pm.expect(data.kyc_status).to.eql('PENDING')); }",
      "if (n === 4) set('admin_token', data.access_token);",
      "if (n === 5) set('customer_token', data.access_token);",
      "if (n === 7) pm.test('KYC verified', () => pm.expect(data.kyc_status).to.eql('VERIFIED'));",
      "if (n === 12) { const a = data.find(x => x.account_number === '1000000001'); pm.expect(a, 'source account').to.exist; set('source_account_id', a.id); }",
      "if (n === 16) set('payee_id', data.id);",
      "if (n === 17) { const i = data.find(x => x.status === 'UNPAID'); pm.expect(i, 'unpaid invoice').to.exist; set('invoice_id', i.id); }",
      "if (n === 19) { set('transaction_id', data.transaction_id); set('transfer_otp', data.development_otp); }",
      "if (n === 20) { pm.collectionVariables.unset('transfer_otp'); pm.test('Transfer success', () => pm.expect(data.status).to.eql('SUCCESS')); }",
      "if (n === 23) { set('payment_id', data.payment_id); set('payment_otp', data.development_otp); }",
      "if (n === 24) { pm.collectionVariables.unset('payment_otp'); pm.test('Payment success', () => pm.expect(data.status).to.eql('SUCCESS')); }",
      "}"
    ]}}
  ],
  "item": [
    {"name":"01 - Root","request":{"method":"GET","url":"{{base_url}}/"}},
    {"name":"02 - Health","request":{"method":"GET","url":"{{base_url}}/health"}},
    {"name":"03 - Register demo customer","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/api/v1/auth/register","body":{"mode":"raw","raw":"{\"username\":\"demo_{{suffix}}\",\"password\":\"{{demo_password}}\",\"email\":\"demo_{{suffix}}@example.com\",\"phone\":\"09{{suffix}}\",\"full_name\":\"Nguyen Van Demo\",\"date_of_birth\":\"2000-01-01\",\"identity_number\":\"DEMO{{suffix}}\",\"address\":\"Ha Noi\"}"}}},
    {"name":"04 - Login admin","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/api/v1/auth/login","body":{"mode":"raw","raw":"{\"username\":\"admin\",\"password\":\"{{admin_password}}\"}"}}},
    {"name":"05 - OAuth2 token customer","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/x-www-form-urlencoded"}],"url":"{{base_url}}/api/v1/auth/token","body":{"mode":"urlencoded","urlencoded":[{"key":"username","value":"customer1","type":"text"},{"key":"password","value":"{{customer_password}}","type":"text"}]}}},
    {"name":"06 - Admin customers pending","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_token}}","type":"string"}]},"url":"{{base_url}}/api/v1/admin/customers?kyc_status=PENDING&page_size=100"}},
    {"name":"07 - Verify KYC","request":{"method":"PUT","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_token}}","type":"string"}]},"header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/api/v1/admin/customers/{{new_customer_id}}/kyc","body":{"mode":"raw","raw":"{\"status\":\"VERIFIED\"}"}}},
    {"name":"08 - Create employee","request":{"method":"POST","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_token}}","type":"string"}]},"header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/api/v1/admin/employees","body":{"mode":"raw","raw":"{\"username\":\"employee_{{suffix}}\",\"password\":\"{{employee_password}}\",\"email\":\"employee_{{suffix}}@example.com\"}"}}},
    {"name":"09 - Admin users","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_token}}","type":"string"}]},"url":"{{base_url}}/api/v1/admin/users?page=1&page_size=100"}},
    {"name":"10 - Admin accounts","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_token}}","type":"string"}]},"url":"{{base_url}}/api/v1/admin/accounts?page=1&page_size=100"}},
    {"name":"11 - Customer profile","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{customer_token}}","type":"string"}]},"url":"{{base_url}}/api/v1/customers/me"}},
    {"name":"12 - Customer accounts","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{customer_token}}","type":"string"}]},"url":"{{base_url}}/api/v1/accounts"}},
    {"name":"13 - Source account","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{customer_token}}","type":"string"}]},"url":"{{base_url}}/api/v1/accounts/{{source_account_id}}"}},
    {"name":"14 - Source balance before","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{customer_token}}","type":"string"}]},"url":"{{base_url}}/api/v1/accounts/{{source_account_id}}/balance"}},
    {"name":"15 - Customer payees","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{customer_token}}","type":"string"}]},"url":"{{base_url}}/api/v1/payees"}},
    {"name":"16 - Add demo payee","request":{"method":"POST","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{customer_token}}","type":"string"}]},"header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/api/v1/payees","body":{"mode":"raw","raw":"{\"name\":\"Nguoi nhan demo\",\"bank_name\":\"DEMO\",\"account_number\":\"99{{suffix}}\",\"nickname\":\"Test {{suffix}}\"}"}}},
    {"name":"17 - Customer invoices","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{customer_token}}","type":"string"}]},"url":"{{base_url}}/api/v1/invoices"}},
    {"name":"18 - Unpaid invoice","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{customer_token}}","type":"string"}]},"url":"{{base_url}}/api/v1/invoices/{{invoice_id}}"}},
    {"name":"19 - Create transfer","request":{"method":"POST","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{customer_token}}","type":"string"}]},"header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/api/v1/transfers","body":{"mode":"raw","raw":"{\"source_account_id\":{{source_account_id}},\"destination_account_number\":\"1000000002\",\"bank_code\":\"LOCAL\",\"amount\":100000,\"description\":\"Full API demo {{suffix}}\"}"}}},
    {"name":"20 - Verify transfer OTP","request":{"method":"POST","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{customer_token}}","type":"string"}]},"header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/api/v1/transfers/{{transaction_id}}/verify-otp","body":{"mode":"raw","raw":"{\"otp\":\"{{transfer_otp}}\"}"}}},
    {"name":"21 - Customer transactions","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{customer_token}}","type":"string"}]},"url":"{{base_url}}/api/v1/transactions?type=INTERNAL_TRANSFER&status=SUCCESS"}},
    {"name":"22 - Source statement","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{customer_token}}","type":"string"}]},"url":"{{base_url}}/api/v1/accounts/{{source_account_id}}/statement"}},
    {"name":"23 - Create invoice payment","request":{"method":"POST","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{customer_token}}","type":"string"}]},"header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/api/v1/payments","body":{"mode":"raw","raw":"{\"invoice_id\":{{invoice_id}},\"account_id\":{{source_account_id}}}"}}},
    {"name":"24 - Verify payment OTP","request":{"method":"POST","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{customer_token}}","type":"string"}]},"header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/api/v1/payments/{{payment_id}}/verify-otp","body":{"mode":"raw","raw":"{\"otp\":\"{{payment_otp}}\"}"}}},
    {"name":"25 - Customer summary","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{customer_token}}","type":"string"}]},"url":"{{base_url}}/api/v1/reports/me/summary"}},
    {"name":"26 - Expenses by category","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{customer_token}}","type":"string"}]},"url":"{{base_url}}/api/v1/reports/me/expenses-by-category"}},
    {"name":"27 - Monthly expenses","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{customer_token}}","type":"string"}]},"url":"{{base_url}}/api/v1/reports/me/monthly-expenses"}},
    {"name":"28 - Delete demo payee","request":{"method":"DELETE","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{customer_token}}","type":"string"}]},"url":"{{base_url}}/api/v1/payees/{{payee_id}}"}},
    {"name":"29 - Admin transaction report","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_token}}","type":"string"}]},"url":"{{base_url}}/api/v1/admin/reports/transactions"}},
    {"name":"30 - Admin audit logs","request":{"method":"GET","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_token}}","type":"string"}]},"url":"{{base_url}}/api/v1/admin/audit-logs?page=1&page_size=100"}}
  ]
}
